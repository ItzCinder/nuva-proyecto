# Comprobación controlada: solo reconoce estas dos rutas HTTP ficticias.
# No necesitas crear archivos en Apache ni modificar una aplicación.
alert http any any -> $HOME_NET any (msg:"LOCAL IDS comprobacion controlada"; flow:established,to_server; http.uri; content:"/__suricata_alerta__"; startswith; endswith; sid:1000001; rev:1;)
drop http any any -> $HOME_NET any (msg:"LOCAL IPS bloqueo controlado"; flow:established,to_server; http.uri; content:"/__suricata_bloqueo__"; startswith; endswith; sid:1000002; rev:1;)

# Las reglas de amenazas reales se descargan con suricata-update (ET Open).
# Una regla alert avisa; solo drop/reject bloquean cuando MODO="ips".
# Revisa cada firma antes de pasarla a bloqueo. No conviertas todo ET Open.
